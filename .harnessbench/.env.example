# Credentials harnessbench could use, from the agent and judge in .harnessbench/config.json.
# Copy this file to .harnessbench/.env (gitignored), uncomment what you use, and fill in the values.
# A variable already set in your shell wins over the file.

# Anthropic API key: for Claude Code, and for judges on the anthropic provider
# ANTHROPIC_API_KEY=

# Bearer token for an Anthropic-compatible gateway, in place of an API key
# ANTHROPIC_AUTH_TOKEN=

# Claude subscription token from `claude setup-token`, in place of an API key
# CLAUDE_CODE_OAUTH_TOKEN=

# Set to 1 to reach Claude through AWS Bedrock; AWS credentials come from your environment
# CLAUDE_CODE_USE_BEDROCK=

# Set to 1 to reach Claude through Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=

# API key for the judge ("judge.apiKeyEnv" in .harnessbench/config.json)
# OPENROUTER_API_KEY=
