{
  "name": "harnessbench",
  "version": "0.1.0",
  "description": "Regression tests for your CLAUDE.md.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harnessbench": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "pretest": "npm run build",
    "test": "node --test 'dist/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
