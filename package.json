{
  "name": "harnessbench",
  "version": "0.1.0",
  "description": "Regression tests for your CLAUDE.md.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harnessbench": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "judges",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "pretest": "npm run build",
    "test": "node --test 'dist/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "ink-testing-library": "4.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/openai-compatible": "3.0.53",
    "ai": "7.0.107",
    "ink": "6.8.0",
    "react": "19.2.0",
    "zod": "4.6.5"
  }
}
